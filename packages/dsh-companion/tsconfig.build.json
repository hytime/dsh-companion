{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": false,
    "rootDir": "src",
    "outDir": "lib/types",
    "declaration": true,
    "sourceMap": false,
    "declarationMap": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "lib",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test"
  ]
}
